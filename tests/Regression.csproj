<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Suite Condition="'$(Suite)' == ''">ReliabilityTests</Suite>
    <AssemblyName>$(Suite)</AssemblyName>
    <StartupObject>$(Suite)</StartupObject>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <AssemblyPath Condition="'$(AssemblyPath)' == ''">$(MSBuildThisFileDirectory)..\artifacts\build\win-x64\ApkShellext2.dll</AssemblyPath>
    <DefineConstants Condition="'$(Suite)' == 'ServiceRegression'">$(DefineConstants);SERVICE_TEST</DefineConstants>
    <NoWarn>$(NoWarn);SYSLIB0050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Suite).cs" />
    <Compile Include="RuntimeContract.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Suite)' != 'ServiceRegression'">
    <Reference Include="ApkShellext2"><HintPath>$(AssemblyPath)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Suite)' == 'OverlayRegression'">
    <Compile Include="IntegratedOverlay.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Suite)' == 'ServiceRegression'">
    <Compile Include="..\ApkShellextService\apkShellextService.cs" Link="apkShellextService.cs" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>
</Project>
